{
  "name": "transporte-tjgo",
  "version": "2.0.0",
  "description": "Sistema de Gestão de Transporte — Tribunal de Justiça do Estado de Goiás",
  "main": "server/server.js",
  "scripts": {
    "start": "node dist/server/server.js",
    "dev": "nodemon server/server.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "build": "npm run build:client && npm run build:server",
    "db:setup": "ts-node server/scripts/db-setup.ts",
    "db:seed": "ts-node server/scripts/db-seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
